{# templates/admin/base_site.html #}
{% extends "admin/base.html" %}
{% load static %}

{% block title %}NexusAI Network Operations{% endblock %}

{% block extrastyle %}
  {{ block.super }}
  <style>
    /* Top header bar */
    #header {
      background: linear-gradient(90deg, #020617, #111827, #1e293b);
      border-bottom: 1px solid rgba(148, 163, 184, 0.5);
      box-shadow: 0 10px 25px rgba(15, 23, 42, 0.35);
    }

    #header .branding h1,
    #header .branding h1 a,
    #header .branding h1 a:link,
    #header .branding h1 a:visited {
      color: #e5e7eb;
      font-size: 20px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Little logo dot */
    #header .branding h1::before {
      content: "";
      width: 11px;
      height: 11px;
      border-radius: 999px;
      background: radial-gradient(circle at 30% 30%, #4ade80, #22c55e);
      box-shadow: 0 0 12px rgba(34, 197, 94, 0.8);
    }

    /* User tools (Welcome, change password, log out) */
    #user-tools {
      color: #e5e7eb;
      font-size: 13px;
    }
    #user-tools a {
      color: #93c5fd;
    }
    #user-tools a:hover {
      color: #bfdbfe;
      text-decoration: none;
    }

    /* Optional: slightly lighten the breadcrumb bar under the header */
    div.breadcrumbs {
      background: #0f172a;
      color: #9ca3af;
      border-bottom: 1px solid rgba(75, 85, 99, 0.7);
    }
    div.breadcrumbs a {
      color: #e5e7eb;
    }
    div.breadcrumbs a:hover {
      color: #bfdbfe;
    }

    /* If you want to hide the sidebar search & auth section globally (not only dashboard): */
    #nav-filter {
      display: none !important;
    }
    #nav-sidebar .app-auth {
      display: none !important;
    }
  </style>
{% endblock %}

{% block branding %}
  <h1 id="site-name">
    <a href="{% url 'admin:index' %}">NexusAI Network Operations</a>
  </h1>
{% endblock %}

{% block nav-global %}{% endblock %}
