# --- Environment Variables & Secrets ---
# This is the most important line. It prevents your secret keys from being uploaded.
.env

# --- Python Virtual Environment ---
# The venv folder is system-specific and can be very large. It should always be ignored.
venv/
/venv/

# --- Python Cache Files ---
# These are automatically generated and not needed in the repository.
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Django Specific ---
# For local databases, which we aren't using, but is good practice.
db.sqlite3
*.log

# --- IDE/Editor Directories ---
# Ignores configuration files from popular editors like VS Code and PyCharm.
.vscode/
.idea/

# --- OS Specific Files ---
# Ignores files generated by macOS and Windows.
.DS_Store
Thumbs.db